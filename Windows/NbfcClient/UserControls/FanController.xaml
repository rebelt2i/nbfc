<UserControl 
    x:Class="NbfcClient.UserControls.FanController"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:NbfcClient.ViewModels"
    
    mc:Ignorable="d"  
    Height="158" 
    Background="White"
    d:DesignHeight="158" 
    d:DesignWidth="343"             
    d:DataContext="{d:DesignData Source=../DesignData/FanControllerViewModelData.xaml}">

    <GroupBox 
        
        Header="{Binding FanDisplayName, Mode=OneWay}"
        FontWeight="SemiBold">       
        
        <Grid>
            <Slider 
                Name="FanSpeedSlider" 
                Height="31" 
                VerticalAlignment="Top" 
                Margin="10,12,65,0" 
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                SmallChange="1"
                Value="{Binding CurrentFanSpeedLevel, Delay=150}" 
                Maximum="{Binding FanSpeedSteps, Mode=OneWay, Converter={StaticResource AddOne}}"/>
            
            <Label 
                HorizontalAlignment="Right" 
                FontWeight="Normal" 
                Margin="0,9,0,0" 
                VerticalAlignment="Top" 
                Width="60">
                
                <MultiBinding Converter="{StaticResource SliderValueToString}">
                    <Binding Path="Value" ElementName="FanSpeedSlider"/>
                    <Binding Path="FanSpeedSteps" Mode="OneWay"/>
                </MultiBinding>
            </Label>
            
            <Label 
                ContentStringFormat="Target fan speed:  {0}"
                FontWeight="Normal"
                Margin="6,30,0,0"
                VerticalAlignment="Top">
                
                <MultiBinding Converter="{StaticResource FanSpeedToString}">
                    <Binding Path="TargetFanSpeed" Mode="OneWay"/>
                    <Binding Path="IsAutoFanControlEnabled" Mode="OneWay"/>
                    <Binding Path="IsCriticalModeEnabled" Mode="OneWay"/>
                </MultiBinding>
            </Label>
            
            <ProgressBar 
                Value="{Binding CurrentFanSpeed, Mode=OneWay}" 
                Height="6"
                Margin="10,79,65,0" 
                VerticalAlignment="Top" />
            
            <Label 
                Content="{Binding CurrentFanSpeed, Mode=OneWay}"
                ContentStringFormat="Current fan speed:  {0:0.0}%"
                FontWeight="Normal"
                Margin="6,85,0,0"
                VerticalAlignment="Top"/>

            <Label
                FontWeight="Normal"
                Margin="6,102,0,0"
                VerticalAlignment="Top">
                <Label.Content>
                    <MultiBinding StringFormat="Temperature: {0}  |  RPM: {1}">
                        <Binding Path="FanTemperatureText" Mode="OneWay"/>
                        <Binding Path="FanRpmText" Mode="OneWay"/>
                    </MultiBinding>
                </Label.Content>
            </Label>
        </Grid>
    </GroupBox>
</UserControl>
